# Copia este archivo como .env.local y rellena con tus valores reales.
# Los encuentras en: supabase.com -> tu proyecto -> Project Settings -> API Keys

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# La URL pública donde vive la app, SIN barra final.
#   desarrollo -> http://localhost:3000
#   producción -> https://tu-dominio.com
#
# Se usa para el enlace de "recuperar contraseña" que va por correo.
# En desarrollo, si falta, se asume localhost:3000. En producción la
# app se niega a enviar el correo antes que mandar un enlace roto.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
