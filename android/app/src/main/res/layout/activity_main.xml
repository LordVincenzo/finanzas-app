<?xml version="1.0" encoding="utf-8"?>
<!--
  La app entera: un WebView a pantalla completa con tu Finanzas.

  Encima, oculta, una pantalla de error propia. El error del WebView es
  una página en inglés que habla de ERR_NAME_NOT_RESOLVED y no ofrece
  salida; esta dice qué pasó, en qué dirección, y lleva a los ajustes,
  que es justo lo que hace falta cuando no carga.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sin conexión"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/reintentar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minWidth="200dp"
            android:text="Reintentar" />

        <Button
            android:id="@+id/ajustes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="200dp"
            android:text="Ajustes"
            style="?attr/borderlessButtonStyle" />

    </LinearLayout>

    <!--
      La cortina del bloqueo.

      Opaca y por ENCIMA de todo: mientras esta puesta no se ve ni un
      peso. Una pantalla semitransparente dejaria leer los saldos de
      fondo, que es justo lo que el bloqueo viene a evitar. Tambien
      tapa lo que Android guarda para la vista de apps recientes.
    -->
    <LinearLayout
        android:id="@+id/bloqueo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Bloqueada"
            android:textSize="14sp" />

        <Button
            android:id="@+id/desbloquear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minWidth="200dp"
            android:text="Desbloquear" />

    </LinearLayout>
</FrameLayout>
