<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lo único que se pide: salir a internet. No hay permiso de SMS,
         ni de contactos, ni de almacenamiento. El acceso a las
         notificaciones no es un permiso normal: se concede a mano desde
         los ajustes del sistema (ver BIND_NOTIFICATION_LISTENER_SERVICE
         más abajo). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Para el aviso de "N por confirmar". Desde Android 13 hay que
         pedirlo en marcha; antes bastaba con declararlo. Si se deniega,
         todo lo demas sigue funcionando igual: se pierde el
         recordatorio, no el gasto. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/red"
        android:theme="@style/Theme.Oyente">

        <!-- La app: el WebView con Finanzas dentro. Sin barra de título
             del sistema, porque la web ya trae su propia cabecera y dos
             encabezados uno encima de otro se ven mal. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- La pantalla de diagnóstico. No exportada: solo se llega
             desde dentro de la app, no desde otras apps. -->
        <activity
            android:name=".AjustesActivity"
            android:exported="false"
            android:label="Diagnóstico"
            android:parentActivityName=".MainActivity" />

        <!-- El servicio que lee las notificaciones.
             BIND_NOTIFICATION_LISTENER_SERVICE lo declara la app, pero
             quien decide es la persona: hasta que no lo active en
             Ajustes -> Acceso a notificaciones, Android no entrega nada.
             android:exported="true" es obligatorio para que el sistema
             pueda enlazarlo. -->
        <service
            android:name=".OyenteNotificaciones"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
